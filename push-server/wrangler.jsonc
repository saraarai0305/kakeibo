{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mainichi-schedule-push",
  "account_id": "47ef761cacbdf48e4227d807ceeb4f50",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "SCHEDULE_REMINDERS", "class_name": "ScheduleReminder" },
      { "name": "DEVICE_SYNC_PAIRINGS", "class_name": "DeviceSyncPairing" },
      { "name": "DAILY_REPORT_INBOX", "class_name": "DailyReportInbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ScheduleReminder"] },
    { "tag": "v2", "new_sqlite_classes": ["DeviceSyncPairing"] },
    { "tag": "v3", "new_sqlite_classes": ["DailyReportInbox"] }
  ]
}
